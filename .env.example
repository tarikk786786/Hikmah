# ==============================================================================
# HIKMAH / JARVIS — AI Operating System Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://hikmah.vercel.app

# ------------------------------------------------------------------------------
# Supabase PostgreSQL & Auth (Primary Source of Truth + pgvector)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Redis / Upstash (Queue & Asynchronous Workers)
# ------------------------------------------------------------------------------
# In-memory queue fallback is automatically used if REDIS_URL is omitted
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# AI Model Providers (Multi-Model Gateway & Router)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local / Self-Hosted AI Inference (Ollama / vLLM fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3:8b

# Model Router Routing Defaults
DEFAULT_FAST_MODEL=gpt-4o-mini
DEFAULT_REASONING_MODEL=gpt-4o
DEFAULT_CODING_MODEL=gpt-4o
DEFAULT_LOCAL_MODEL=llama3:8b

# ------------------------------------------------------------------------------
# Step 25 — PAIOS Privacy & Governance
# ------------------------------------------------------------------------------
# Privacy Mode: normal | private | offline | air-gapped
PAIOS_DEFAULT_PRIVACY_MODE=normal
PAIOS_AUTO_APPROVE_SAFE=true
HIKMAH_KILL_SWITCH=false
HIKMAH_MAX_AUTO_APPROVE_RISK=LOW

# ------------------------------------------------------------------------------
# Storage Engine (PRD 10)
# ------------------------------------------------------------------------------
STORAGE_MASTER_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# Search, Research & Browser Engines (PRDs 11, 12)
# ------------------------------------------------------------------------------
SEARXNG_URL=http://localhost:8080
CRAWL4AI_URL=http://localhost:11235
HIKMAH_BROWSER_HEADLESS=true
HIKMAH_BROWSER_DEFAULT_TIMEOUT_MS=30000
